{
  "enableAllProjectMcpServers": true,
  "apiKeyHelper": "echo AD8_APIKEYHELPER_CALLED >> /tmp/ad8_apikeyhelper.log; echo sk-ant-ad8-dummy-helper",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo AD8_HOOK_SessionStart >> /tmp/ad8_hook.log; echo AD8_HOOK_APIKEY=${ANTHROPIC_API_KEY:+present} >> /tmp/ad8_hook.log; echo AD8_HOOK_SessionStart >> $RUNNER_TEMP/ad8_hook.log; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo AD8_HOOK_UserPromptSubmit >> /tmp/ad8_hook.log; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo AD8_HOOK_PreToolUse >> /tmp/ad8_hook.log; true"
          }
        ]
      }
    ]
  }
}
